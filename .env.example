# Local development: sqlite. Vercel production: supabase.
EVAORBIT_DATA_BACKEND=sqlite
EVAORBIT_SQLITE_PATH=./data/eva-orbit.db
EVAORBIT_TIME_ZONE=Asia/Shanghai
# Optional local-only avatar directory. Production uses private Supabase Storage.
EVAORBIT_AVATAR_DIR=./data/avatars
EVAORBIT_TRACKER_ICON_DIR=./data/tracker-icons

# Supabase server-side configuration (do not prefix with NEXT_PUBLIC_).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
EVAORBIT_ALLOWED_EMAIL=you@example.com

# Used by migration/import scripts. Prefer the Supabase pooler connection string.
DATABASE_URL=postgresql://postgres.your-project-ref:password@host:6543/postgres

# Required for encrypting API Keys entered in Settings. Keep it stable and server-only.
# Generate a 32-byte Base64 value, for example: openssl rand -base64 32
EVAORBIT_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Optional development-only fallback. Production ignores AI_API_KEY.
AI_API_KEY=

# Shared Reminder Web Push. Generate one VAPID key pair and keep the private key server-only.
EVAORBIT_VAPID_PUBLIC_KEY=
EVAORBIT_VAPID_PRIVATE_KEY=
EVAORBIT_VAPID_SUBJECT=mailto:you@example.com
# The configured scheduler sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Required by the server-side delivery job to read each user's due reminders/subscriptions.
SUPABASE_SECRET_KEY=
