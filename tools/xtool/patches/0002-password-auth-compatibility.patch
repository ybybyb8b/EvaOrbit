diff --git a/Sources/XKit/GrandSlam/GrandSlamHTTPDiagnostics.swift b/Sources/XKit/GrandSlam/GrandSlamHTTPDiagnostics.swift
new file mode 100644
index 0000000..dd8e9e1
--- /dev/null
+++ b/Sources/XKit/GrandSlam/GrandSlamHTTPDiagnostics.swift
@@ -0,0 +1,179 @@
+//
+//  GrandSlamHTTPDiagnostics.swift
+//  XKit
+//
+//  Safe transport diagnostics for Apple's private authentication endpoints.
+//
+
+import Foundation
+import HTTPTypes
+
+struct GrandSlamHTTPResponseError: Error, LocalizedError {
+    enum Failure: String {
+        case httpStatus = "unexpected-http-status"
+        case responseDecode = "unexpected-response-body"
+    }
+
+    let failure: Failure
+    let request: String
+    let endpoint: String
+    let statusCode: Int
+    let contentType: String
+    let responseKind: String
+    let byteCount: Int
+    let requestCookieState: String
+    let responseSetCookieCount: String
+
+    var errorDescription: String? {
+        "Apple authentication failed (reason=\(failure.rawValue), request=\(request), "
+            + "endpoint=\(endpoint), status=\(statusCode), content-type=\(contentType), "
+            + "response=\(responseKind), bytes=\(byteCount), request-cookie=\(requestCookieState), "
+            + "response-set-cookie-count=\(responseSetCookieCount)). "
+            + "The response body was intentionally not logged."
+    }
+}
+
+enum GrandSlamHTTPDiagnostics {
+    struct Metadata {
+        let request: String
+        let endpoint: String
+        let statusCode: Int
+        let contentType: String
+        let responseKind: String
+        let byteCount: Int
+        let requestCookieState: String
+        let responseSetCookieCount: String
+
+        func error(_ failure: GrandSlamHTTPResponseError.Failure) -> GrandSlamHTTPResponseError {
+            GrandSlamHTTPResponseError(
+                failure: failure,
+                request: request,
+                endpoint: endpoint,
+                statusCode: statusCode,
+                contentType: contentType,
+                responseKind: responseKind,
+                byteCount: byteCount,
+                requestCookieState: requestCookieState,
+                responseSetCookieCount: responseSetCookieCount
+            )
+        }
+    }
+
+    private static var isEnabled: Bool {
+        ProcessInfo.processInfo.environment["XTL_AUTH_DIAGNOSTICS"] == "1"
+    }
+
+    static func logStage(_ stage: String) {
+        guard isEnabled else { return }
+        print("[xtool-auth] stage=\(stage)")
+    }
+
+    static func inspect(
+        response: HTTPResponse,
+        body: Data,
+        url: URL,
+        request: String,
+        requestCookiePresent: Bool? = nil,
+        responseSetCookieCount: Int? = nil
+    ) throws -> Metadata {
+        let contentType = response.headerFields[.contentType] ?? "<missing>"
+        let metadata = Metadata(
+            request: request,
+            endpoint: sanitizedEndpoint(url),
+            statusCode: response.status.code,
+            contentType: contentType,
+            responseKind: classify(body: body, contentType: contentType),
+            byteCount: body.count,
+            requestCookieState: requestCookiePresent.map { $0 ? "present" : "absent" } ?? "transport-managed",
+            responseSetCookieCount: responseSetCookieCount.map(String.init) ?? "transport-managed"
+        )
+
+        if isEnabled {
+            print(
+                "[xtool-auth-http] request=\(metadata.request) endpoint=\(metadata.endpoint) "
+                    + "status=\(metadata.statusCode) content-type=\(metadata.contentType) "
+                    + "response=\(metadata.responseKind) bytes=\(metadata.byteCount) "
+                    + "request-cookie=\(metadata.requestCookieState) "
+                    + "response-set-cookie-count=\(metadata.responseSetCookieCount)"
+            )
+        }
+
+        guard (200..<300).contains(metadata.statusCode) else {
+            throw metadata.error(.httpStatus)
+        }
+        return metadata
+    }
+
+    private static func sanitizedEndpoint(_ url: URL) -> String {
+        guard let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let scheme = components.scheme,
+              let host = components.host
+        else { return "<invalid-url>" }
+        return "\(scheme)://\(host)\(components.percentEncodedPath)"
+    }
+
+    private static func classify(body: Data, contentType: String) -> String {
+        if body.isEmpty { return "empty" }
+
+        let mediaType = contentType.lowercased()
+        if mediaType.contains("html") { return "html" }
+        if mediaType.contains("plist") { return "plist" }
+        if mediaType.contains("json") { return "json" }
+
+        if body.starts(with: Data("bplist".utf8)) { return "plist" }
+        let prefix = String(decoding: body.prefix(256), as: UTF8.self)
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+            .lowercased()
+        if prefix.hasPrefix("<!doctype html") || prefix.hasPrefix("<html") {
+            return "html"
+        }
+        if prefix.hasPrefix("<?xml") || prefix.hasPrefix("<plist") {
+            return "plist"
+        }
+        if prefix.hasPrefix("{") || prefix.hasPrefix("[") {
+            return "json"
+        }
+        return "other"
+    }
+}
+
+#if os(Linux)
+actor GrandSlamCookieJar {
+    private var cookies: [String: String] = [:]
+
+    func requestHeader() -> String? {
+        guard !cookies.isEmpty else { return nil }
+        return cookies.keys.sorted().compactMap { name in
+            cookies[name].map { "\(name)=\($0)" }
+        }.joined(separator: "; ")
+    }
+
+    @discardableResult
+    func store(response: HTTPResponse) -> Int {
+        let fields = response.headerFields[values: .setCookie]
+        for field in fields {
+            let components = field.split(separator: ";", omittingEmptySubsequences: false)
+            guard let pair = components.first,
+                  let separator = pair.firstIndex(of: "=")
+            else { continue }
+
+            let name = String(pair[..<separator]).trimmingCharacters(in: .whitespaces)
+            let value = String(pair[pair.index(after: separator)...]).trimmingCharacters(in: .whitespaces)
+            guard !name.isEmpty,
+                  !name.contains("\r"), !name.contains("\n"),
+                  !value.contains("\r"), !value.contains("\n")
+            else { continue }
+
+            let removesCookie = value.isEmpty || components.dropFirst().contains { attribute in
+                String(attribute).trimmingCharacters(in: .whitespaces).lowercased() == "max-age=0"
+            }
+            if removesCookie {
+                cookies.removeValue(forKey: name)
+            } else {
+                cookies[name] = value
+            }
+        }
+        return fields.count
+    }
+}
+#endif
