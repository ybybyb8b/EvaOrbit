@@ -0,0 +1,20 @@
+import Foundation
+import Testing
+@testable import XKit
+
+@Test func evaOrbitHealthKitEntitlementsSurviveSerializationAndSupportPersonalTeam() throws {
+    let dictionary: [String: Any] = [
+        "com.apple.developer.healthkit": true,
+        "com.apple.developer.healthkit.background-delivery": true,
+    ]
+    let data = try PropertyListSerialization.data(fromPropertyList: dictionary, format: .xml, options: 0)
+    let entitlements = try PropertyListDecoder().decode(Entitlements.self, from: data)
+    let health = try #require(entitlements.entitlements().compactMap { $0 as? HealthKitEntitlement }.first)
+    let background = try #require(entitlements.entitlements().compactMap { $0 as? HealthKitBackgroundDeliveryEntitlement }.first)
+    #expect(health.rawValue && background.rawValue)
+    #expect(health.capability.isFree && background.capability.isFree)
+    let encoded = try PropertyListEncoder().encode(entitlements)
+    let decoded = try #require(PropertyListSerialization.propertyList(from: encoded, format: nil) as? [String: Any])
+    #expect(decoded["com.apple.developer.healthkit"] as? Bool == true)
+    #expect(decoded["com.apple.developer.healthkit.background-delivery"] as? Bool == true)
+}
